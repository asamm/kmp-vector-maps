<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        No storage permissions needed: the viewer reads from the app's
        own external-files dir (getExternalFilesDir). adb-push the IMG
        there before launching — see MainActivity for the path.
    -->

    <application
        android:label="GarminIMG Viewer"
        android:icon="@android:drawable/ic_menu_mapmode"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
